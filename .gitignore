# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets stay local; commit only the example)
.env*
!.env.example

# uploaded videos and engine output (local jobs)
/data/

# local test media and logs (recordings can be many GB)
*.mp4
*.mov
*.mkv
*.log

# editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# notes that `next dev` writes for AI coding tools (local only)
AGENTS.md
CLAUDE.md
